{
  "name": "probato-pr",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.2.1",
  "publisher": "armotusitio",
  "author": {
    "name": "Alejandro Daniel Di Stefano",
    "url": "https://armotusitio.com.ar"
  },
  "license": "MIT",
  "homepage": "https://armotusitio.com.ar",
  "repository": {
    "type": "git",
    "url": "https://github.com/Drako01/probato-pr.git"
  },
  "bugs": {
    "url": "https://github.com/Drako01/probato-pr/issues"
  },
  "private": true,
  "pricing": "Free",
  "preview": true,
  "icon": "media/logo.png",
  "galleryBanner": {
    "color": "#14181d",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.99.0",
    "node": ">=22.12.0"
  },
  "categories": [
    "Linters",
    "Testing",
    "Other"
  ],
  "keywords": [
    "code review",
    "pull request",
    "regression",
    "verification",
    "sarif",
    "evidence",
    "php",
    "python",
    "rust",
    "java"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "activationEvents": [
    "onWebviewPanel:probatoPR.summary"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%capabilities.untrustedWorkspaces%"
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "%capabilities.virtualWorkspaces%"
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "probatoPR.reviewCurrentChanges",
        "title": "%command.reviewCurrentChanges%",
        "category": "Probato PR",
        "icon": "$(git-compare)"
      },
      {
        "command": "probatoPR.reviewStagedChanges",
        "title": "%command.reviewStagedChanges%",
        "category": "Probato PR"
      },
      {
        "command": "probatoPR.reviewBranch",
        "title": "%command.reviewBranch%",
        "category": "Probato PR"
      },
      {
        "command": "probatoPR.reviewCommit",
        "title": "%command.reviewCommit%",
        "category": "Probato PR"
      },
      {
        "command": "probatoPR.reviewPullRequest",
        "title": "%command.reviewPullRequest%",
        "category": "Probato PR"
      },
      {
        "command": "probatoPR.verify",
        "title": "%command.verify%",
        "category": "Probato PR",
        "icon": "$(beaker)"
      },
      {
        "command": "probatoPR.aiReview",
        "title": "%command.aiReview%",
        "category": "Probato PR",
        "icon": "$(sparkle)"
      },
      {
        "command": "probatoPR.connectAi",
        "title": "%command.connectAi%",
        "category": "Probato PR",
        "icon": "$(plug)"
      },
      {
        "command": "probatoPR.forgetAiKeys",
        "title": "%command.forgetAiKeys%",
        "category": "Probato PR"
      },
      {
        "command": "probatoPR.forgetApprovedChecks",
        "title": "%command.forgetApprovedChecks%",
        "category": "Probato PR"
      },
      {
        "command": "probatoPR.showResults",
        "title": "%command.showResults%",
        "category": "Probato PR",
        "icon": "$(preview)"
      },
      {
        "command": "probatoPR.copyPullRequestDescription",
        "title": "%command.copyPullRequestDescription%",
        "category": "Probato PR",
        "icon": "$(copy)"
      },
      {
        "command": "probatoPR.exportReport",
        "title": "%command.exportReport%",
        "category": "Probato PR",
        "icon": "$(export)"
      },
      {
        "command": "probatoPR.openMarkdownReport",
        "title": "%command.openMarkdownReport%",
        "category": "Probato PR",
        "icon": "$(markdown)"
      },
      {
        "command": "probatoPR.cancel",
        "title": "%command.cancel%",
        "category": "Probato PR",
        "icon": "$(debug-stop)"
      },
      {
        "command": "probatoPR.clearHistory",
        "title": "%command.clearHistory%",
        "category": "Probato PR"
      },
      {
        "command": "probatoPR.openFinding",
        "title": "%command.openFinding%",
        "category": "Probato PR"
      },
      {
        "command": "probatoPR.openEvidence",
        "title": "%command.openEvidence%",
        "category": "Probato PR"
      },
      {
        "command": "probatoPR.dismissFinding",
        "title": "%command.dismissFinding%",
        "category": "Probato PR",
        "icon": "$(eye-closed)"
      },
      {
        "command": "probatoPR.restoreDismissed",
        "title": "%command.restoreDismissed%",
        "category": "Probato PR"
      },
      {
        "command": "probatoPR.groupFindingsByFile",
        "title": "%command.groupFindingsByFile%",
        "category": "Probato PR",
        "icon": "$(files)"
      },
      {
        "command": "probatoPR.groupFindingsBySeverity",
        "title": "%command.groupFindingsBySeverity%",
        "category": "Probato PR",
        "icon": "$(list-tree)"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "probatoPR.reviewCurrentChanges",
          "when": "scmProvider == git && isWorkspaceTrusted",
          "group": "navigation@50"
        }
      ],
      "view/item/context": [
        {
          "command": "probatoPR.dismissFinding",
          "when": "view == probatoPR.findings && viewItem == probatoFinding",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "probatoPR.dismissFinding",
          "when": "false"
        },
        {
          "command": "probatoPR.openFinding",
          "when": "false"
        },
        {
          "command": "probatoPR.openEvidence",
          "when": "false"
        },
        {
          "command": "probatoPR.verify",
          "when": "probatoPR.hasReview"
        },
        {
          "command": "probatoPR.aiReview",
          "when": "probatoPR.hasReview"
        },
        {
          "command": "probatoPR.exportReport",
          "when": "probatoPR.hasReview"
        },
        {
          "command": "probatoPR.cancel",
          "when": "probatoPR.busy"
        },
        {
          "command": "probatoPR.openMarkdownReport",
          "when": "probatoPR.hasReview"
        },
        {
          "command": "probatoPR.groupFindingsByFile",
          "when": "false"
        },
        {
          "command": "probatoPR.groupFindingsBySeverity",
          "when": "false"
        },
        {
          "command": "probatoPR.copyPullRequestDescription",
          "when": "probatoPR.hasReview"
        }
      ],
      "view/title": [
        {
          "command": "probatoPR.reviewCurrentChanges",
          "when": "view == probatoPR.overview && !probatoPR.busy",
          "group": "navigation@1"
        },
        {
          "command": "probatoPR.verify",
          "when": "view == probatoPR.verification && probatoPR.hasReview && !probatoPR.busy",
          "group": "navigation@1"
        },
        {
          "command": "probatoPR.cancel",
          "when": "view =~ /^probatoPR\\./ && probatoPR.busy",
          "group": "navigation@0"
        },
        {
          "command": "probatoPR.showResults",
          "when": "view == probatoPR.findings && probatoPR.hasReview",
          "group": "navigation@1"
        },
        {
          "command": "probatoPR.exportReport",
          "when": "view == probatoPR.findings && probatoPR.hasReview",
          "group": "navigation@2"
        },
        {
          "command": "probatoPR.groupFindingsByFile",
          "when": "view == probatoPR.findings && probatoPR.hasReview && probatoPR.findingsGrouping != file",
          "group": "navigation@0"
        },
        {
          "command": "probatoPR.groupFindingsBySeverity",
          "when": "view == probatoPR.findings && probatoPR.hasReview && probatoPR.findingsGrouping == file",
          "group": "navigation@0"
        },
        {
          "command": "probatoPR.showResults",
          "when": "view == probatoPR.overview && probatoPR.hasReview",
          "group": "navigation@2"
        },
        {
          "command": "probatoPR.copyPullRequestDescription",
          "when": "view == probatoPR.findings && probatoPR.hasReview",
          "group": "navigation@3"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "probatoPR",
          "title": "Probato PR",
          "icon": "media/mark.svg"
        }
      ]
    },
    "views": {
      "probatoPR": [
        {
          "id": "probatoPR.overview",
          "name": "%view.overview%"
        },
        {
          "id": "probatoPR.findings",
          "name": "%view.findings%"
        },
        {
          "id": "probatoPR.verification",
          "name": "%view.verification%"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "probatoPR.overview",
        "contents": "%welcome.overview%",
        "when": "workspaceFolderCount > 0 && isWorkspaceTrusted && !probatoPR.hasReview && !probatoPR.busy"
      },
      {
        "view": "probatoPR.overview",
        "contents": "%welcome.untrusted%",
        "when": "!isWorkspaceTrusted"
      },
      {
        "view": "probatoPR.overview",
        "contents": "%welcome.noFolder%",
        "when": "workspaceFolderCount == 0"
      },
      {
        "view": "probatoPR.findings",
        "contents": "%welcome.findings.noReview%",
        "when": "!probatoPR.hasReview"
      },
      {
        "view": "probatoPR.findings",
        "contents": "%welcome.findings.none%",
        "when": "probatoPR.hasReview && probatoPR.visibleFindings == 0"
      },
      {
        "view": "probatoPR.verification",
        "contents": "%welcome.verification.noReview%",
        "when": "!probatoPR.hasReview"
      }
    ],
    "configuration": {
      "title": "Probato PR",
      "properties": {
        "probatoPR.review.baseBranch": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.review.baseBranch%"
        },
        "probatoPR.review.maxFiles": {
          "type": "integer",
          "default": 300,
          "minimum": 1,
          "maximum": 5000,
          "description": "%config.review.maxFiles%"
        },
        "probatoPR.review.maxDiffBytes": {
          "type": "integer",
          "default": 4000000,
          "minimum": 10000,
          "description": "%config.review.maxDiffBytes%"
        },
        "probatoPR.review.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/node_modules/**",
            "**/dist/**",
            "**/vendor/**",
            "**/*.min.js",
            "**/*.lock",
            "**/package-lock.json",
            "**/pnpm-lock.yaml"
          ],
          "description": "%config.review.exclude%"
        },
        "probatoPR.verification.timeoutSeconds": {
          "type": "integer",
          "default": 600,
          "minimum": 5,
          "maximum": 7200,
          "description": "%config.verification.timeoutSeconds%"
        },
        "probatoPR.verification.maxOutputBytes": {
          "type": "integer",
          "default": 1000000,
          "minimum": 10000,
          "description": "%config.verification.maxOutputBytes%"
        },
        "probatoPR.verification.baseline": {
          "type": "string",
          "enum": [
            "ask",
            "always",
            "never"
          ],
          "default": "ask",
          "enumDescriptions": [
            "%config.verification.baseline.ask%",
            "%config.verification.baseline.always%",
            "%config.verification.baseline.never%"
          ],
          "description": "%config.verification.baseline%"
        },
        "probatoPR.ai.provider": {
          "type": "string",
          "enum": [
            "none",
            "vscode-lm",
            "anthropic",
            "openai-compatible"
          ],
          "default": "none",
          "enumDescriptions": [
            "%config.ai.provider.none%",
            "%config.ai.provider.vscodeLm%",
            "%config.ai.provider.anthropic%",
            "%config.ai.provider.openaiCompatible%"
          ],
          "markdownDescription": "%config.ai.provider%"
        },
        "probatoPR.ai.anthropicModel": {
          "type": "string",
          "default": "claude-opus-5-5",
          "description": "%config.ai.anthropicModel%"
        },
        "probatoPR.ai.vscodeLmModel": {
          "type": "string",
          "default": "",
          "description": "%config.ai.vscodeLmModel%"
        },
        "probatoPR.ai.openaiCompatible.baseUrl": {
          "type": "string",
          "default": "https://api.openai.com/v1",
          "scope": "application",
          "markdownDescription": "%config.ai.openaiCompatible.baseUrl%"
        },
        "probatoPR.ai.openaiCompatible.model": {
          "type": "string",
          "default": "",
          "description": "%config.ai.openaiCompatible.model%"
        },
        "probatoPR.ai.includeFileContent": {
          "type": "boolean",
          "default": true,
          "description": "%config.ai.includeFileContent%"
        },
        "probatoPR.ai.maxContextChars": {
          "type": "integer",
          "default": 120000,
          "minimum": 2000,
          "maximum": 1000000,
          "description": "%config.ai.maxContextChars%"
        },
        "probatoPR.ai.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%config.ai.exclude%"
        }
      }
    },
    "walkthroughs": [
      {
        "id": "getStarted",
        "title": "%walkthrough.title%",
        "description": "%walkthrough.description%",
        "steps": [
          {
            "id": "review",
            "title": "%walkthrough.review.title%",
            "description": "%walkthrough.review.description%",
            "media": {
              "image": "media/logo.svg",
              "altText": "Probato PR"
            },
            "completionEvents": [
              "onCommand:probatoPR.reviewCurrentChanges",
              "onCommand:probatoPR.reviewBranch",
              "onCommand:probatoPR.reviewStagedChanges",
              "onCommand:probatoPR.reviewCommit",
              "onCommand:probatoPR.reviewPullRequest"
            ]
          },
          {
            "id": "verify",
            "title": "%walkthrough.verify.title%",
            "description": "%walkthrough.verify.description%",
            "media": {
              "image": "media/logo.svg",
              "altText": "Probato PR"
            },
            "completionEvents": [
              "onCommand:probatoPR.verify"
            ]
          },
          {
            "id": "share",
            "title": "%walkthrough.share.title%",
            "description": "%walkthrough.share.description%",
            "media": {
              "image": "media/logo.svg",
              "altText": "Probato PR"
            },
            "completionEvents": [
              "onCommand:probatoPR.exportReport",
              "onCommand:probatoPR.openMarkdownReport"
            ]
          },
          {
            "id": "ai",
            "title": "%walkthrough.ai.title%",
            "description": "%walkthrough.ai.description%",
            "media": {
              "image": "media/logo.svg",
              "altText": "Probato PR"
            },
            "completionEvents": [
              "onCommand:probatoPR.connectAi",
              "onSettingChanged:probatoPR.ai.provider"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "build:prod": "node esbuild.mjs --production",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p . --noEmit && tsc -p src/webview --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "pnpm run build && tsc -p test/integration && node out/integration/run.js",
    "perf": "vitest run --config vitest.perf.config.mts",
    "audit": "pnpm audit --prod",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run test",
    "package": "pnpm run verify && vsce package --no-dependencies --out probato-pr.vsix",
    "vscode:prepublish": "pnpm run build:prod && node scripts/third-party-notices.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "typescript": "6.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/mocha": "10.0.10",
    "@types/node": "20.19.43",
    "@types/vscode": "1.99.1",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.1.0",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "mocha": "12.0.3",
    "ovsx": "1.3.0",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@12.4.2"
}
