# TEMPLATE — NOT ENABLED. Copy to .github/workflows/publish.yml only after the maintainer authorizes publishing.
# Publishes to the Visual Studio Marketplace with Trusted Publishing (OIDC): no Personal Access Token is stored anywhere.
# Before enabling (see docs/PUBLICACION.md, "Publicaciones siguientes"):
#   1. Create a Trusted Publishing policy for publisher "armotusitio": owner Drako01, repository probato-pr,
#      workflow file publish.yml, environment marketplace.
#   2. Create the GitHub environment "marketplace" with required reviewers, so every publish needs a manual approval.
#   3. Pin every third-party action to a full commit SHA (replace the <sha> placeholders).
name: publish

on:
  push:
    tags: ['v*.*.*']

permissions:
  contents: read

concurrency:
  group: publish
  cancel-in-progress: false

jobs:
  publish:
    runs-on: ubuntu-latest
    environment: marketplace
    permissions:
      contents: read
      id-token: write # OIDC token exchanged with the Marketplace; nothing else can publish
    steps:
      - uses: actions/checkout@<sha> # v4
      - uses: pnpm/action-setup@<sha> # v4
      - uses: actions/setup-node@<sha> # v4
        with:
          node-version: 22
          cache: pnpm
      - run: pnpm install --frozen-lockfile
      - name: Tag matches package.json version
        run: test "v$(node -p "require('./package.json').version")" = "${GITHUB_REF_NAME}"
      - run: pnpm run verify
      - run: pnpm audit --prod
      - run: xvfb-run -a pnpm run test:integration
      - run: pnpm run package
      - name: Record the VSIX checksum
        run: sha256sum probato-pr.vsix | tee probato-pr.vsix.sha256
      - name: Publish to the Visual Studio Marketplace
        run: pnpm exec vsce publish --oidc --packagePath probato-pr.vsix
      - uses: actions/upload-artifact@<sha> # v4
        with:
          name: probato-pr-vsix
          path: |
            probato-pr.vsix
            probato-pr.vsix.sha256
